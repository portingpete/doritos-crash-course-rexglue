{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win-amd64",
      "displayName": "Windows AMD64",
      "description": "Windows x64 build using the local ReXGlue Ninja/Clang workflow.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/win-amd64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo;Release",
        "CMAKE_CROSS_CONFIGS": "all",
        "CMAKE_DEFAULT_BUILD_TYPE": "Debug",
        "CMAKE_DEFAULT_CONFIGS": "all"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-amd64-debug",
      "configurePreset": "win-amd64",
      "configuration": "Debug"
    },
    {
      "name": "win-amd64-relwithdebinfo",
      "configurePreset": "win-amd64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-amd64-release",
      "configurePreset": "win-amd64",
      "configuration": "Release"
    }
  ]
}

